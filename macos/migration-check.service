[Unit]
Description=Inspect Try Omarchy migrations in a disposable disk overlay
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target

[Service]
Type=oneshot
TimeoutStartSec=90
ExecStartPre=/usr/bin/udevadm settle --timeout=10
ExecStartPre=/usr/bin/mkdir -p /run/try-omarchy-check
ExecStartPre=/usr/bin/modprobe 9pnet_virtio
ExecStartPre=/usr/bin/mount -t 9p -o ro,trans=virtio,version=9p2000.L try-omarchy-settings /run/try-omarchy-check
ExecStart=/usr/bin/python3 -I /run/try-omarchy-check/migrate.py --inspect
ExecStopPost=/usr/bin/systemctl --no-block poweroff
